        </profile>
      </profiles>
      <rules>
        <rule name="Runes of Gazul" id="7c6a170b-e33b-42f0-81b2-18f02be5332c" hidden="false">
          <description>Subtract 1 from ward rolls for damage points inflicted by this unit’s combat attacks.</description>
        </rule>
        <rule name="Source notes" id="279c8efe-7c87-4273-99c4-d641a154fd5d" hidden="false">
          <description>3 models, reinforceable to 6. Great hammer: 3 attacks, 4+/2+, Rend 2, Damage 3.</description>
        </rule>
        <rule name="Armor-Crushing Swings" id="ff077fb2-242c-47dc-89d3-ae378f664305" hidden="false">
          <description>Pick an enemy unit in combat with this unit. Its controller chooses whether it attempts to sidestep. If it does, subtract 1 from its hit rolls for the rest of the turn. Then roll a die, subtracting 1 if the target attempted to sidestep. If the result equals or exceeds the target’s Save characteristic, subtract 1 from its save rolls for the rest of the turn.</description>
        </rule>
      </rules>
    </selectionEntry>
