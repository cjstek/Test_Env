        <rule name="Shield Strike" id="5ecf630f-2d95-4a54-ad3d-f82cbc0f76ab" hidden="false">
          <description>If this unit charged this turn, pick a visible enemy unit within 1 inch and roll a die. On 3+, the target has Strike-Last for the rest of the turn.</description>
        </rule>
      </rules>
