          <characteristic name="Notes" typeId="8951ae70-9c86-4e48-a60a-918fbd4dc0d8">About 110 points as spoken, not confirmed. Melee: 5 attacks, 3+/3+, Rend 1, Damage 2.</characteristic>
        </characteristics>
      </profile>
      <rules>
        <rule name="Steadfast Retribution" id="240b2158-35fc-4967-b796-7b74ae4ecc90" hidden="false">
          <description>Add 1 to the Attacks characteristic of this unit’s melee weapons for each other visible friendly unit within 6 inches that has any grudge marks, to a maximum of +3.</description>
        </rule>
        <rule name="Source notes" id="6df4b744-9524-420c-b6ad-1ee91f415ad3" hidden="false">
          <description>About 110 points as spoken, not confirmed. Melee: 5 attacks, 3+/3+, Rend 1, Damage 2.</description>
        </rule>
        <rule name="Fight Shoulder-to-Shoulder" id="31fe05ae-40f6-4796-a0dc-83796f2caae5" hidden="false">
          <description>If this unit is next to a Chromdrawn infantry unit, one fights first and the other fights immediately afterward; you can give either of them +1 to hit. Full text not read; narrator summary only.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Runewright" id="b825fdd6-a2ab-4547-ade2-8372797018f0" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="HERO" id="a23e3c4b-cab8-4113-8c79-77e5de975cf8" hidden="false" primary="true" targetId="6efc7105-e25b-4f9f-bd9a-3b73075cd402" />
        <categoryLink name="INFANTRY" id="dea165e2-1724-4d29-ad12-e187b5a8e6bf" hidden="false" primary="false" targetId="192028a0-5459-4015-878e-ad5e84da6f7e" />
        <categoryLink name="WIZARD" id="d5786c6b-c158-4e26-9d62-f2046441ecf2" hidden="false" primary="false" targetId="76caecfb-9a38-4a21-b153-88350b01b121" />
      </categoryLinks>
      <profile name="Runewright" id="3f49b31a-37dd-4b5c-a049-ca656564e0c7" hidden="false" typeId="c99ca9c0-79df-4dca-a98e-ffef5dca31e7" typeName="Unit">
        <characteristics>
          <characteristic name="Move" typeId="f15e88a1-2a18-4ad1-9941-fbb5cf08fbd5">4"</characteristic>
          <characteristic name="Health" typeId="bb8593db-e170-49a8-af19-31519e0880d6">5</characteristic>
          <characteristic name="Save" typeId="7fd7856f-6b37-4866-8041-19e4cc3686d6">4+</characteristic>
          <characteristic name="Control" typeId="80174e08-fa10-41dd-ba11-14b56e198bcd">2</characteristic>
          <characteristic name="Ward" typeId="6c555bcb-a905-4341-b5b3-b72c64446d83">—</characteristic>
          <characteristic name="Notes" typeId="8951ae70-9c86-4e48-a60a-918fbd4dc0d8">Wizard 1. Weapon profiles not read out.</characteristic>
        </characteristics>
      </profile>
      <rules>
        <rule name="Grudgement of the Forge" id="1ea2b43b-a512-44fc-b9f3-142c044819ed" hidden="false">
          <description>Add 1 to unbinding rolls, banishment rolls and Rhythmic Hammering rolls while this unit has any grudge marks.</description>
        </rule>
        <rule name="Source notes" id="53c65271-d570-44cb-b47f-345aa6137ba8" hidden="false">
          <description>Wizard 1. Weapon profiles not read out.</description>
        </rule>
        <rule name="Rhythmic Hammering" id="103cd1b0-283a-4ad7-8804-ede7d48698d4" hidden="false">
          <description>After casting a spell from either Khazalite Holds lore, roll 2D6. If the result equals or exceeds the spell’s casting value, add 3 inches to the spell’s range. Repeat, accumulating range, until a roll is lower than the casting value. A roll below the casting value causes the spell to fail and its effect is not resolved. Narrator says this does not work with manifestation-summoning spells.</description>
        </rule>
      </rules>
    </selectionEntry>
