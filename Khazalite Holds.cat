      <rules>
        <rule name="Magmadroth transport" id="f7fbe641-c286-493e-a4eb-ea949f07b7bc" hidden="false">
          <description>Pick a visible friendly Grimdron infantry unit wholly within 6 inches that is not in combat and has not been set up this turn. Remove it. After this unit ends its move, set the target up wholly within 6 inches of this unit and not in combat; narrator says also more than 9 inches from enemies. Unless this unit has any grudge marks, the target cannot charge for the rest of the turn.</description>
        </rule>
        <rule name="Source notes" id="3417d4d3-4f22-4948-b58e-c128d396be7e" hidden="false">
          <description>Main melee profile weaker than Runefather; no Rend 2 or Damage 3. Magmadroth companion weapon same.</description>
        </rule>
        <rule name="Calamitous Crash" id="72d47370-ddd4-4bdc-aecc-0f53c614f99c" hidden="false">
          <description>Pick an enemy unit in combat with this unit and roll a die. On 3+, roll a die for each model in the target unit; for each 5+, inflict 1 mortal damage on the target.</description>
        </rule>
        <rule name="Volcanic Blood" id="40de2896-7756-49d9-8fe1-75b053ef099c" hidden="false">
          <description>Each time you make an unmodified save roll of 1 for a combat attack that targets this unit, inflict mortal damage on the attacking unit after its fight ability resolves.</description>
        </rule>
      </rules>
    </selectionEntry>
