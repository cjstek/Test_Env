            <characteristic name="Hit" typeId="fea51aed-f2c7-4e65-ace8-81cf296114b1">4+</characteristic>
            <characteristic name="Wnd" typeId="210a99f2-fd0f-4a1f-9518-626de4f86b78">2+</characteristic>
            <characteristic name="Rnd" typeId="de895003-0c12-41cd-9e59-a8ee6ffea077">2</characteristic>
            <characteristic name="Dmg" typeId="d02f7c40-8cd6-44fe-bc3b-a26e37eba4e9">3</characteristic>
            <characteristic name="Ability" typeId="670db2c4-339a-4f1c-a6a7-b50ed04195c5">—</characteristic>
