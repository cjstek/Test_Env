            <characteristic name="Dmg" typeId="c4792f8d-bb30-4834-96b9-0aed53a2144a">1</characteristic>
            <characteristic name="Ability" typeId="bb5069be-cbd1-4f74-b9d2-cd2e874ce850">—</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Grudge-marked shooting" id="794f2af4-af4e-45ce-9035-5dff36ea8655" hidden="false">
          <description>Add 1 to wound rolls for this unit’s shooting attacks while it has any grudge marks. Ability name not captured.</description>
        </rule>
        <rule name="Source notes" id="98090288-c71e-4426-96c0-278987c58ce4" hidden="false">
          <description>10 models, reinforceable to 20. Rifle 18", 2 attacks, 3+/4+, Rend 1, Damage 1.</description>
        </rule>
        <rule name="Thunderdrop Hail" id="c0f44c23-c85b-4642-bec0-539f81c41669" hidden="false">
          <description>Pick an enemy unit that suffered damage points from this unit’s shooting attacks this turn and roll a die. Add 1 if the target is cavalry or has Fly; add 2 instead if it is a Monster. On 4+, halve the target’s Move characteristic until the start of your next turn.</description>
        </rule>
      </rules>
    </selectionEntry>
