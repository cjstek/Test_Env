      <rules>
        <rule name="Once-per-battle attack buff (name not captured)" id="16bfe2a1-c88a-4c25-8c4b-c28bdec63202" hidden="false">
          <description>For the rest of the battle, add 1 to Attacks of melee weapons used by Grimdron units wholly within 12 inches. If this unit has any grudge marks, for the rest of the turn also add 1 to Attacks of melee weapons used by Grimdron and Chromdrawn units wholly within 12 inches. Captions garbled; verify.</description>
        </rule>
        <rule name="Source notes" id="5403edbf-f518-4243-bd81-c6653d083ef5" hidden="false">
