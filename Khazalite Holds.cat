      <profile name="High King Valencrom" id="bb533d84-b7fc-4061-ba79-5ad1d2d05707" hidden="false" typeId="c99ca9c0-79df-4dca-a98e-ffef5dca31e7" typeName="Unit">
        <characteristics>
          <characteristic name="Move" typeId="f15e88a1-2a18-4ad1-9941-fbb5cf08fbd5">10"</characteristic>
          <characteristic name="Health" typeId="bb8593db-e170-49a8-af19-31519e0880d6">16</characteristic>
          <characteristic name="Save" typeId="7fd7856f-6b37-4866-8041-19e4cc3686d6">3+</characteristic>
          <characteristic name="Control" typeId="80174e08-fa10-41dd-ba11-14b56e198bcd">5</characteristic>
          <characteristic name="Ward" typeId="6c555bcb-a905-4341-b5b3-b72c64446d83">—</characteristic>
          <characteristic name="Notes" typeId="8951ae70-9c86-4e48-a60a-918fbd4dc0d8">War Master; keywords as spoken: Hero, Unique, War Master, War Machine.</characteristic>
        </characteristics>
      </profile>
      <profiles>
        <profile name="Forge Spark Lightning" id="e0d2806a-79a9-44f9-b9e7-e3b02ebbc7aa" hidden="false" typeId="c34771fa-4170-418c-ba03-172ed1ba06a3" typeName="Ranged Weapon">
          <characteristics>
            <characteristic name="Rng" typeId="9008da00-8227-4295-9474-5e8d8ef53db1">12"</characteristic>
            <characteristic name="Atk" typeId="e217b95a-8e11-4d1f-83c2-f3fd1ceeeb2a">6</characteristic>
            <characteristic name="Hit" typeId="ba26751d-f1dd-4c64-a1bc-920d9772e776">4+?</characteristic>
            <characteristic name="Wnd" typeId="bc397a60-0482-4347-938e-2462eca3b43a">2+?</characteristic>
            <characteristic name="Rnd" typeId="fb21e126-8265-43de-b2b4-a46c1bcdc628">2</characteristic>
            <characteristic name="Dmg" typeId="c4792f8d-bb30-4834-96b9-0aed53a2144a">1</characteristic>
            <characteristic name="Ability" typeId="bb5069be-cbd1-4f74-b9d2-cd2e874ce850">Crit (2 Hits)</characteristic>
          </characteristics>
        </profile>
        <profile name="Barrang" id="9a5075dc-7c3b-43ac-9dd0-fa4357f2654d" hidden="false" typeId="ee0f43ac-266a-4d29-97d4-6c81c03bf13e" typeName="Melee Weapon">
          <characteristics>
            <characteristic name="Atk" typeId="76f787d6-a96d-4739-8948-c75b036ea476">6</characteristic>
            <characteristic name="Hit" typeId="fea51aed-f2c7-4e65-ace8-81cf296114b1">3+</characteristic>
            <characteristic name="Wnd" typeId="210a99f2-fd0f-4a1f-9518-626de4f86b78">3+</characteristic>
            <characteristic name="Rnd" typeId="de895003-0c12-41cd-9e59-a8ee6ffea077">2</characteristic>
            <characteristic name="Dmg" typeId="d02f7c40-8cd6-44fe-bc3b-a26e37eba4e9">3</characteristic>
            <characteristic name="Ability" typeId="670db2c4-339a-4f1c-a6a7-b50ed04195c5">Anti-Monster (+1 Rend); Crit (Mortal)</characteristic>
          </characteristics>
        </profile>
        <profile name="War Council" id="87d138c1-e079-4275-ada5-cb3114837d24" hidden="false" typeId="ee0f43ac-266a-4d29-97d4-6c81c03bf13e" typeName="Melee Weapon">
          <characteristics>
            <characteristic name="Atk" typeId="76f787d6-a96d-4739-8948-c75b036ea476">6</characteristic>
            <characteristic name="Hit" typeId="fea51aed-f2c7-4e65-ace8-81cf296114b1">3+</characteristic>
            <characteristic name="Wnd" typeId="210a99f2-fd0f-4a1f-9518-626de4f86b78">3+</characteristic>
            <characteristic name="Rnd" typeId="de895003-0c12-41cd-9e59-a8ee6ffea077">1</characteristic>
            <characteristic name="Dmg" typeId="d02f7c40-8cd6-44fe-bc3b-a26e37eba4e9">2</characteristic>
            <characteristic name="Ability" typeId="670db2c4-339a-4f1c-a6a7-b50ed04195c5">—</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Tide of Stone" id="77891336-902e-4b2d-a7e7-ef6d05b36801" hidden="false">
          <description>This unit can move D6 inches, or 2D6 inches during your movement phase. It can pass through models and enemy combat ranges but cannot end in combat. Pick an enemy unit it passed across and roll a die; on 3+, inflict mortal damage equal to the roll.</description>
        </rule>
        <rule name="Source notes" id="9cfd5ab9-890c-484e-ad4a-b5d84091a4ba" hidden="false">
          <description>War Master; keywords as spoken: Hero, Unique, War Master, War Machine.</description>
        </rule>
        <rule name="Defend the High Throne" id="480760c8-2ea0-40fe-9d84-03dbe70f881c" hidden="false">
          <description>Pick another visible friendly Khazalite Holds unit within 12 inches as target, plus one additional eligible unit for each grudge mark this unit has. Until the end of the turn, while a target is wholly within 6 inches of this unit, its melee weapons have Anti-charge (+1 Rend). Add 3 inches to that range for each grudge mark this unit has. A target with no grudge marks counts as having one.</description>
        </rule>
        <rule name="High War Council" id="91b30289-4f61-4330-89cb-a80fb140a2b7" hidden="false">
          <description>Choose one effect until the start of your next turn: Stonesmith — pick a visible enemy unit within 12 inches; its maximum control score becomes 1. Grudgebringer’s Denunciation — visible friendly Khazalite Holds units wholly within 12 inches can charge even if they retreated this turn; they suffer no mortal damage from that retreat but still lose a grudge mark. Holdseeker’s Guidance — add 1 to casting, chanting and banishment rolls for friendly units wholly within 12 inches.</description>
        </rule>
        <rule name="Stirring the High King’s Ire" id="7c2cac61-91f0-459d-8115-5642d418369a" hidden="false">
          <description>Pick a visible enemy hero within 18 inches that has not previously been targeted by this ability. Its controller accepts or rejects the accusation. If accepted, until the start of your next turn add 1 to hit rolls for combat attacks by friendly Khazalite Holds units. If rejected, that hero cannot use commands until the start of your next turn. Name garbled in captions.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Thrin on War Throne" id="0730c648-c25b-44c9-910c-8629d4b73934" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="HERO" id="edae7aeb-81e0-4515-b93f-fb25ae6626a4" hidden="false" primary="true" targetId="6efc7105-e25b-4f9f-bd9a-3b73075cd402" />
        <categoryLink name="WAR MACHINE" id="e7a8fa28-a1e3-415c-aefa-130bbcc5435e" hidden="false" primary="false" targetId="4084f492-92de-4d0a-96bf-13efc0400068" />
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="340" />
      </costs>
      <profile name="Thrin on War Throne" id="dfd3ac4c-720d-47ae-9f68-b7c2c6faac7f" hidden="false" typeId="c99ca9c0-79df-4dca-a98e-ffef5dca31e7" typeName="Unit">
        <characteristics>
          <characteristic name="Move" typeId="f15e88a1-2a18-4ad1-9941-fbb5cf08fbd5">10"</characteristic>
          <characteristic name="Health" typeId="bb8593db-e170-49a8-af19-31519e0880d6">16</characteristic>
          <characteristic name="Save" typeId="7fd7856f-6b37-4866-8041-19e4cc3686d6">3+</characteristic>
          <characteristic name="Control" typeId="80174e08-fa10-41dd-ba11-14b56e198bcd">—</characteristic>
          <characteristic name="Ward" typeId="6c555bcb-a905-4341-b5b3-b72c64446d83">—</characteristic>
          <characteristic name="Notes" typeId="8951ae70-9c86-4e48-a60a-918fbd4dc0d8">Non-unique. Weapon profiles were not read out; narrator described them as similar to the High King.</characteristic>
        </characteristics>
      </profile>
      <rules>
        <rule name="Defend the Throne" id="05c8294b-0e35-48f7-ba1b-2025fece4e76" hidden="false">
          <description>Pick another visible friendly Khazalite Holds unit within 12 inches as target, plus one additional eligible unit for each grudge mark this unit has. Until the end of the turn, targets’ melee weapons have Anti-charge (+1 Rend) while wholly within 6 inches of this unit. Add 3 inches to that range for each grudge mark this unit has. Unlike the High King version, no “counts as having one grudge mark” clause was reported.</description>
        </rule>
        <rule name="Source notes" id="5799c813-fdf6-4ac7-aa52-e8c024c67397" hidden="false">
          <description>Non-unique. Weapon profiles were not read out; narrator described them as similar to the High King.</description>
        </rule>
        <rule name="Carak War Council" id="bf95b5e2-f971-4534-a3fc-6d2e14b65595" hidden="false">
          <description>Choose one effect until the start of your next turn: Stonesmith’s Passage — add 2 inches to Move for visible friendly Khazalite Holds infantry wholly within 12 inches; they suffer no mortal damage from retreat abilities but still lose a grudge mark. Grudgebearer’s Accusation — pick a visible enemy hero within 18 inches; friendly Khazalite Holds infantry can ignore Guarded Hero when choosing it as a shooting target. Holdseeker’s Protection — pick a visible friendly unit within 12 inches and roll a die; on 3+, weapon abilities for attacks that target it have no effect except companion weapon abilities.</description>
        </rule>
        <rule name="Forge a Path" id="538a9e7e-2ca0-4e28-9ae1-dec68748c1aa" hidden="false">
          <description>Pick a visible friendly Chromdrawn infantry unit wholly within 6 inches that has not been set up this turn (Fire Slayers cannot be chosen). Remove it. After this unit ends its move, set the target up within 6 inches of this unit and more than 9 inches from all enemy units.</description>
        </rule>
        <rule name="Tectonic Impact" id="f097358a-7fdf-45ea-9eaa-79eed20fa450" hidden="false">
          <description>If this unit charged this turn, pick a visible enemy unit within 1 inch and roll a die. On 3+, inflict mortal damage equal to the roll.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Hilda the Drab-Blood" id="28f946a0-37eb-4b4d-b776-baa273998ce0" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="HERO" id="60f49bbe-8d21-45cb-9029-c9acd1d4051f" hidden="false" primary="true" targetId="6efc7105-e25b-4f9f-bd9a-3b73075cd402" />
        <categoryLink name="INFANTRY" id="6ff6bda3-1016-420f-8f66-ebead2f3073f" hidden="false" primary="false" targetId="192028a0-5459-4015-878e-ad5e84da6f7e" />
        <categoryLink name="UNIQUE" id="33c355b9-940b-4ebf-aaba-ec8d178bf096" hidden="false" primary="false" targetId="edb93ff4-c7bb-4c58-9fda-6e5bc7f08ba0" />
      </categoryLinks>
      <profile name="Hilda the Drab-Blood" id="b15a3e6d-3318-4d0b-8cfb-b4bcc360e567" hidden="false" typeId="c99ca9c0-79df-4dca-a98e-ffef5dca31e7" typeName="Unit">
        <characteristics>
          <characteristic name="Move" typeId="f15e88a1-2a18-4ad1-9941-fbb5cf08fbd5">4"</characteristic>
          <characteristic name="Health" typeId="bb8593db-e170-49a8-af19-31519e0880d6">5</characteristic>
          <characteristic name="Save" typeId="7fd7856f-6b37-4866-8041-19e4cc3686d6">3+</characteristic>
          <characteristic name="Control" typeId="80174e08-fa10-41dd-ba11-14b56e198bcd">2</characteristic>
          <characteristic name="Ward" typeId="6c555bcb-a905-4341-b5b3-b72c64446d83">—</characteristic>
          <characteristic name="Notes" typeId="8951ae70-9c86-4e48-a60a-918fbd4dc0d8">Unique infantry hero; not a wizard or priest. Weapon: 6 attacks, Damage 2, Crit (Mortal); hit/wound/rend unclear.</characteristic>
        </characteristics>
      </profile>
      <rules>
        <rule name="Talisman of the Lost Carak" id="7a3fd234-6470-4741-abe9-e90d9118fcc0" hidden="false">
          <description>While this unit is in combat, add 1 to hit rolls for combat attacks by friendly non-hero Khazalite Holds infantry units within 3 inches of it and visible to it.</description>
        </rule>
        <rule name="Source notes" id="81c383e9-0205-40c9-87a8-88abfeab5146" hidden="false">
          <description>Unique infantry hero; not a wizard or priest. Weapon: 6 attacks, Damage 2, Crit (Mortal); hit/wound/rend unclear.</description>
        </rule>
        <rule name="Book of the Fallen Holds" id="faaa60d3-1ccb-462a-a22b-62c24404df5e" hidden="false">
          <description>Pick an enemy unit to be grudged; it can be in reserve. For the rest of the battle, while the grudged unit is within 12 inches of and visible to this unit, friendly Khazalite Holds units wholly within 12 inches of this unit can re-roll charge rolls.</description>
        </rule>
        <rule name="Last of a Clan" id="aec6912e-3b7f-4799-b951-e4f3a3ad8821" hidden="false">
          <description>Pick this unit and up to two other visible friendly non-hero Khazalite Holds units within 12 inches. If this unit has any grudge marks, the effect applies automatically; otherwise roll a die and it applies on 3+. Ignore the first damage point that would be allocated to each target in each phase.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Thrin (Foot Hero)" id="0a1b3146-82f4-4321-ae06-632d582d90e9" hidden="false" import="true" type="unit">
      <categoryLinks>
