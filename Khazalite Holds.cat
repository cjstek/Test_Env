      <rules>
        <rule name="Royal Retinue" id="372e173e-3e77-4918-900d-949c7bc6f044" hidden="false">
          <description>Pick a friendly non-hero Grimdron infantry unit within this unit’s combat range as its Royal Retinue for the battle. While the Retinue is wholly within 6 inches, captions mention +1 to hit and a 4+ ward save; exact wording is garbled.</description>
        </rule>
        <rule name="Source notes" id="d2f9aed0-ab31-4d3b-a3f6-812ab1bfabc3" hidden="false">
