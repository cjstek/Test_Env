        <rule name="Volcanic Blood" id="1c1996c1-1637-4f68-b04b-a8a461e925cd" hidden="false">
          <description>Each time you make an unmodified save roll of 1 for a combat attack that targets this unit, inflict mortal damage on the attacking unit after its fight ability resolves.</description>
        </rule>
      </rules>
