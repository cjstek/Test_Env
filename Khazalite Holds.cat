        </characteristics>
      </profile>
      <profiles>
        <profile name="Melee weapon (name not captured)" id="d4572910-f354-4d59-b422-52880d3de8bf" hidden="false" typeId="ee0f43ac-266a-4d29-97d4-6c81c03bf13e" typeName="Melee Weapon">
          <characteristics>
