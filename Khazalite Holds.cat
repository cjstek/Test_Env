          <characteristic name="Ward" typeId="6c555bcb-a905-4341-b5b3-b72c64446d83">—</characteristic>
          <characteristic name="Notes" typeId="8951ae70-9c86-4e48-a60a-918fbd4dc0d8">Hero; neither priest nor wizard. Move, health, save and weapon profiles not read out.</characteristic>
        </characteristics>
      </profile>
      <rules>
        <rule name="Master Flame Rune" id="b1be1aef-70a4-4740-baf5-4a109acdd45e" hidden="false">
          <description>Pick a visible friendly Grimdron infantry unit wholly within 12 inches. Roll a die. It succeeds on a 1, or if the roll is equal to or less than the number of friendly Khazalite Holds units destroyed so far. If successful, choose one until the start of your next turn: target has a 5+ ward; re-roll its charge rolls; or add 1 to Damage of its melee weapons.</description>
        </rule>
        <rule name="Source notes" id="fd5ffc9c-1f8c-40f4-9d59-856a31b3290e" hidden="false">
          <description>Hero; neither priest nor wizard. Move, health, save and weapon profiles not read out.</description>
        </rule>
        <rule name="Fire-Fueled Anger" id="63f7b80f-7f0d-46f7-a406-bfcd04890cd5" hidden="false">
          <description>Subtract 2 from Master Flame Rune rolls for this unit while it has any grudge marks. Lower rolls succeed, making success easier.</description>
        </rule>
        <rule name="Relight the Fire" id="c214e597-2648-4b57-be51-1396664194e3" hidden="false">
          <description>If this unit is destroyed before being removed from play, give each visible friendly Grimdron unit within 6 inches one grudge mark.</description>
        </rule>
      </rules>
    </selectionEntry>
