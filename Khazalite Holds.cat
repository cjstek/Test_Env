          <characteristic name="Health" typeId="bb8593db-e170-49a8-af19-31519e0880d6">8</characteristic>
          <characteristic name="Save" typeId="7fd7856f-6b37-4866-8041-19e4cc3686d6">5+</characteristic>
          <characteristic name="Control" typeId="80174e08-fa10-41dd-ba11-14b56e198bcd">—</characteristic>
          <characteristic name="Ward" typeId="6c555bcb-a905-4341-b5b3-b72c64446d83">—</characteristic>
          <characteristic name="Notes" typeId="8951ae70-9c86-4e48-a60a-918fbd4dc0d8">Ward 3+. Axes: 8 attacks, 2+/2+, Rend 2, Damage 3, Crit (Mortal).</characteristic>
        </characteristics>
      </profile>
      <profiles>
        <profile name="Gotrek’s axes (name garbled)" id="97deb2c1-9eab-4163-8213-4e185a97f6da" hidden="false" typeId="ee0f43ac-266a-4d29-97d4-6c81c03bf13e" typeName="Melee Weapon">
          <characteristics>
            <characteristic name="Atk" typeId="76f787d6-a96d-4739-8948-c75b036ea476">8</characteristic>
            <characteristic name="Hit" typeId="fea51aed-f2c7-4e65-ace8-81cf296114b1">2+</characteristic>
            <characteristic name="Wnd" typeId="210a99f2-fd0f-4a1f-9518-626de4f86b78">2+</characteristic>
            <characteristic name="Rnd" typeId="de895003-0c12-41cd-9e59-a8ee6ffea077">2</characteristic>
            <characteristic name="Dmg" typeId="d02f7c40-8cd6-44fe-bc3b-a26e37eba4e9">3</characteristic>
            <characteristic name="Ability" typeId="670db2c4-339a-4f1c-a6a7-b50ed04195c5">Crit (Mortal)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Indifferent and Pragmatic" id="e8da5eb3-d0ca-480f-ab01-d4d87efbf54f" hidden="false">
          <description>This unit cannot have grudge marks and cannot be affected by ancestral vow abilities.</description>
        </rule>
        <rule name="Source notes" id="2994f757-c618-49b3-9adb-90f1eb4cc086" hidden="false">
          <description>Ward 3+. Axes: 8 attacks, 2+/2+, Rend 2, Damage 3, Crit (Mortal).</description>
        </rule>
        <rule name="Too Stubborn to Die" id="fa57b650-fbdd-4ac8-b5d1-ba881ca818e6" hidden="false">
          <description>The first time this unit would be destroyed before being removed from play, roll a die. On 3+, it is not destroyed and any remaining damage points have no effect. Then heal D3 damage points.</description>
        </rule>
        <rule name="A Glorious Doom" id="9fde60f7-d8d5-4cc4-9d1a-3e30bf213189" hidden="false">
          <description>While this unit is in combat with enemy Heroes or Monsters, it can only pick those enemy units as targets for combat attacks. Add 2 to Attacks of its melee weapons for each such enemy Hero or Monster unit in combat with it. A unit that is both Hero and Monster counts once.</description>
        </rule>
      </rules>
    </selectionEntry>
