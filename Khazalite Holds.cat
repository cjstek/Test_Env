      <profiles>
        <profile name="Thunderdrop rifle" id="c368af42-109a-463e-b0eb-b67cc2190283" hidden="false" typeId="c34771fa-4170-418c-ba03-172ed1ba06a3" typeName="Ranged Weapon">
          <characteristics>
            <characteristic name="Rng" typeId="9008da00-8227-4295-9474-5e8d8ef53db1">18"</characteristic>
            <characteristic name="Atk" typeId="e217b95a-8e11-4d1f-83c2-f3fd1ceeeb2a">2</characteristic>
