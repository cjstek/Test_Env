      </profiles>
      <rules>
        <rule name="Tougher Than Stone" id="7ca1b4c4-f1b8-432f-838c-0f5b978b7ae7" hidden="false">
          <description>Subtract 1 from the Rend characteristic of weapons used for combat attacks that target this unit while every model in the unit is within 3 inches of an objective you control.</description>
        </rule>
        <rule name="Source notes" id="635810ea-0651-45c8-907d-7401c4a019d4" hidden="false">
          <description>10 models, reinforceable to 20. 220 points likely for 20 models. Chrom weapons: melee 2, hit 3+, wound 4+, Rend —, Damage 1, Anti-infantry (+1 Rend).</description>
        </rule>
        <rule name="Remember Their Names" id="c231b2cf-a369-408a-8af5-53b00f794126" hidden="false">
          <description>Add 1 to wound rolls for this unit’s attacks while it has any grudge marks.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Clan Gunners (Thunderdrop Rifles)" id="b101d1d5-9021-437d-9f3f-10dac880a614" hidden="false" import="true" type="unit">
